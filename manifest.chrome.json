{
  "manifest_version": 3,
  "name": "GPTChatDownloader",
  "version": "2.0.0",
  "description": "Export ChatGPT chats as Markdown, text, JSON, or CSV. Copy to clipboard or save to GitHub, with message selection and dark mode.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "offscreen",
    "downloads",
    "storage"
  ],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageBridge.js"],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "action": {
    "default_title": "GPTChatDownloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html"
}
