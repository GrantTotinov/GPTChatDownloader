{
  "manifest_version": 3,
  "name": "GPTChatDownloader",
  "version": "0.2.0",
  "description": "Export ChatGPT conversations as Markdown.",

  "icons": {
    "16": "icons/icon16.png"
  },

  "permissions": [
    "activeTab",
    "clipboardWrite",
    "offscreen",
    "downloads",
    "storage"
  ],

  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["pageBridge.js"],
      "matches": ["https://chatgpt.com/*"]
    }
  ],

  "action": {
    "default_title": "GPTChatDownloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  },

  "options_page": "options.html"
}
